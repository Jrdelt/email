{
  "name": "phishing-email-detection-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Privacy-first browser extension for local phishing detection in webmail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jrdelt/email.git",
    "directory": "extension"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:edge": "wxt -b edge",
    "build": "wxt build && npm run sync:chrome",
    "build:chrome": "wxt build -b chrome && npm run sync:chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "sync:chrome": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('../chrome-mv3',{recursive:true,force:true}); fs.cpSync('.output/chrome-mv3','../chrome-mv3',{recursive:true});\"",
    "zip:all": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
